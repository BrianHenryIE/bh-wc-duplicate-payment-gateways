{
    "name": "brianhenryie/bh-wc-duplicate-payment-gateways",
    "description": "Enables multiple instances of WooCommerce payment gateways.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0+-or-later",
    "authors": [
        {
            "name": "Brian Henry",
            "email": "BrianHenryIE@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "roots/wordpress-core-installer": true
        },
        "platform": {
            "php": "8.4"
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "repositories": [
        {
            "name": "brianhenryie/strauss",
            "type": "package",
            "package": {
                "name": "brianhenryie/strauss",
                "version": "0.31.0",
                "dist": {
                    "url": "https://github.com/BrianHenryIE/strauss/releases/download/0.31.0/strauss.phar",
                    "type": "phar"
                },
                "installation-source": "dist",
                "bin": "bin/strauss"
            }
        },
        {
            "name": "outlandish/wpackagist",
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": [
                "wpackagist-plugin/*",
                "wpackagist-theme/*"
            ]
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "alleyinteractive/wordpress-autoloader": "^1.1"
    },
    "require-dev": {
        "10up/wp_mock": "^1.1",
        "antecedent/patchwork": "^2.2",
        "brianhenryie/strauss": "0.31.0",
        "lucatume/wp-browser": "^4.5",
        "php-stubs/woocommerce-stubs": "*",
        "phpcompatibility/phpcompatibility-wp": "*",
        "phpstan/extension-installer": "*",
        "phpunit/phpcov": "*",
        "roots/wordpress-core-installer": "*",
        "roots/wordpress-no-content": "*",
        "szepeviktor/phpstan-wordpress": "*",
        "wp-cli/dist-archive-command": "dev-main",
        "wp-cli/i18n-command": "*",
        "wp-coding-standards/wpcs": "*",
        "wpackagist-plugin/plugin-check": "^2.1",
        "wpackagist-plugin/query-monitor": "*",
        "wpackagist-plugin/user-switching": "*",
        "wpackagist-plugin/woocommerce": ">=11.2",
        "wpackagist-theme/twentytwentyfive": "^1.5"
    },
    "autoload-dev": {
        "classmap": [
            "tests/unit",
            "tests/wpunit",
            "tests/integration",
            "tests/_support"
        ]
    },
    "extra": {
        "strauss": {
            "namespace_prefix": "BrianHenryIE\\WC_Duplicate_Payment_Gateways\\",
            "classmap_prefix": "BH_WC_Duplicate_Payment_Gateways_",
            "constant_prefix": "BH_WC_DUPLICATE_PAYMENT_GATEWAYS_",
            "namespace_replacement_patterns": {
                "~BrianHenryIE\\\\(.*)~": "BrianHenryIE\\WC_Duplicate_Payment_Gateways\\\\$1"
            }
        },
        "installer-paths": {
            "wp-content/plugins/{$name}/": [
                "type:wordpress-plugin"
            ],
            "wp-content/themes/{$name}/": [
                "type:wordpress-theme"
            ]
        },
        "wordpress-install-dir": "wordpress"
    },
    "scripts": {
        "prefix-namespaces": [
            "php -d memory_limit=1G vendor/bin/strauss"
        ],
        "post-install-cmd": [
            "@prefix-namespaces",
            "@symlink-plugin"
        ],
        "post-update-cmd": [
            "@prefix-namespaces",
            "@symlink-plugin"
        ],
        "post-autoload-dump": [
            "vendor/bin/strauss include-autoloader",
            "php ./bin/sync-composer-wpenv.php",
            "php ./bin/modify-autoload-patchwork.php"
        ],
        "test": [
            "codecept run unit",
            "codecept run wpunit",
            "codecept run integration"
        ],
        "test-coverage": [
            "codecept run unit --coverage unit.cov",
            "codecept run wpunit --coverage wpunit.cov",
            "phpcov merge --clover tests/_output/clover.xml --html tests/_output/html tests/_output;",
            "open tests/_output/html/index.html"
        ],
        "cs": [
            "phpcs || true",
            "phpstan analyse --memory-limit 1G"
        ],
        "cs-fix": [
            "phpcbf || true",
            "@cs"
        ],
        "cs-changes": [
            "updated_files=$(echo $(git diff --name-only `git merge-base master HEAD` | grep \\.php | tr '\\n' '\\0' | xargs -0 ls -1df 2>/dev/null)); if [ -n \"$updated_files\" ]; then phpcbf $(echo $updated_files); phpcs $(echo $updated_files); phpstan analyse $(echo $updated_files) --memory-limit 1G; else echo \"No modified php files for phpstan.\"; fi;"
        ],
        "php-compatibility": [
            "phpcs -p src bh-wc-duplicate-payment-gateways.php autoload.php uninstall.php vendor-prefixed --standard=PHPCompatibilityWP --runtime-set testVersion 7.4-"
        ],
        "create-plugin-archive": [
            "wp i18n make-pot src languages/bh-wc-duplicate-payment-gateways.pot --domain=bh-wc-duplicate-payment-gateways",
            "wp dist-archive . ./dist-archive --plugin-dirname=bh-wc-duplicate-payment-gateways --create-target-dir"
        ],
        "symlink-plugin": [
            "[ -e wp-content/plugins/bh-wc-duplicate-payment-gateways ] || ln -s ../.. wp-content/plugins/bh-wc-duplicate-payment-gateways"
        ]
    }
}
